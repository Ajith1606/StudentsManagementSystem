@page "/SystemCode-list"
@using StudentsManagement.Client.Services;
@using StudentsManagement.Shared.Models
@inject NavigationManager navigation;
@inject IJSRuntime JsRuntime


<div class="container">
    <div class="row">
        <p><a class="btn btn-success float-end" href="/Add-SystemCode">Add New System Code</a></p>
        <div class="col-md-12">
            <div class="card">
                <div class="card-header"></div>
                @if (!AllSystemCode.Any())
                {
                    <p><em> Loading SystemCodes....</em></p>
                }
                @if (AllSystemCode.Any())
                {
                    <div class="card-body">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var systemCode in AllSystemCode)
                                {
                                    <tr>
                                        <td>@systemCode.Id</td>
                                        <td>@systemCode.Code</td>
                                        <td>@systemCode.Description</td>

                                        <td>
                                            <a class="btn btn-success" href="/systemcode/edit/@systemCode.Id"> Edit </a>
                                        </td>
       
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">There is no System Code List available</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<SystemCode> AllSystemCode = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllSystemCode();
    }

    private async Task LoadAllSystemCode()
    {
        var systemcodes = await SystemCodeService.GetAllAsync();

        if (systemcodes is null) return;

        AllSystemCode.Clear();
        AllSystemCode.AddRange(systemcodes);


    }
}

