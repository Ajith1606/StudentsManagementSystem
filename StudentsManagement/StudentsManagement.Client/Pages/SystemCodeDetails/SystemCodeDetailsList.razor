@page "/SystemCodeDetails-list"
@using StudentsManagement.Client.Services;
@using StudentsManagement.Shared.Models
@inject NavigationManager navigation;
@inject IJSRuntime JsRuntime


<div class="container">
    <div class="row">
        <p><a class="btn btn-success float-end" href="/Add-SystemCodeDetails">Add New System Code Details</a></p>
        <div class="col-md-12">
            <div class="card">
                <div class="card-header"></div>
                @if (!AllSystemCodeDetails.Any())
                {
                    <p><em> Loading SystemCodesDetails....</em></p>
                }
                @if (AllSystemCodeDetails.Any())
                {
                    <div class="card-body">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>System Code</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var systemCodeDetails in AllSystemCodeDetails)
                                {
                                    <tr>
                                        <td>@systemCodeDetails.Id</td>
                                        <td>@systemCodeDetails.Code</td>
                                        <td>@systemCodeDetails.Description</td>
                                        <td>@systemCodeDetails.SystemCode.Description</td>
                                        <td>
                                            <a class="btn btn-success" href="/systemcodedetails/edit/@systemCodeDetails.Id"> Edit </a>
                                        </td>
       
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">There is no SystemCodeDetails List available</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<SystemCodeDetails> AllSystemCodeDetails = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllSystemCodeDetails();
    }

    private async Task LoadAllSystemCodeDetails()
    {
        var systemcodesdetails = await SystemCodeDetailsService.GetAllAsync();

        if (systemcodesdetails is null) return;

        AllSystemCodeDetails.Clear();
        AllSystemCodeDetails.AddRange(systemcodesdetails);


    }
}

